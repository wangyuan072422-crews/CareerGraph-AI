OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen2.5-coder:7b
OLLAMA_REASONING_MODEL=deepseek-r1:1.5b
OLLAMA_EMBEDDING_MODEL=bge-m3:latest

# Chroma 本地向量索引
CHROMA_PERSIST_DIRECTORY=./data/chroma
CHROMA_COLLECTION_NAME=career_knowledge_v1
CHROMA_BATCH_SIZE=64


# Checkpoint MySQL 配置（可选）
# 只有本机 MySQL 凭据和后端都配置完成后才改为 mysql。
CHECKPOINTER_BACKEND=memory
# MYSQL_URL=mysql://langgraph_user:replace-with-url-encoded-password@localhost:3306/langgraph_db
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=langgraph_user
MYSQL_PASSWORD=replace-with-checkpoint-password
MYSQL_DATABASE=langgraph_db

# 业务数据 MySQL 配置（与检查点存储分开）
# 仅由只读的求职申请查询工具使用。
BUSINESS_DB_HOST=localhost
BUSINESS_DB_PORT=3306
BUSINESS_DB_USER=career_app
BUSINESS_DB_PASSWORD=replace-with-readonly-password
BUSINESS_DB_DATABASE=career_assistant
BUSINESS_DB_CONNECT_TIMEOUT=5

# API 服务配置
API_HOST=0.0.0.0
API_PORT=8000

# LangSmith 配置（可选）
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your-langsmith-api-key
# LANGCHAIN_PROJECT=careergraph-ai
