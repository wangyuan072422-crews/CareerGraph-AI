OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen3:4b
OLLAMA_REASONING_MODEL=deepseek-r1:1.5b
OLLAMA_EMBEDDING_MODEL=bge-m3:latest


# OpenAI API Configuration
# OPENAI_API_KEY=your-openai-api-key-here

# MySQL Configuration (optional - for production)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=langgraph_user
MYSQL_PASSWORD=your-password-here
MYSQL_DATABASE=langgraph_db

# API Server Configuration
API_HOST=0.0.0.0
API_PORT=8000

# LangSmith Configuration (optional - for debugging)
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your-langsmith-api-key
# LANGCHAIN_PROJECT=langgraph-multi-agent
